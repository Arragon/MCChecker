{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "workers": 4,
    "ssl": {
      "enabled": true,
      "cert": "/path/to/cert.pem",
      "key": "/path/to/key.pem"
    }
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "mydb",
    "user": "admin",
    "password": "secret",
    "pool_size": 10
  },
  "logging": {
    "level": "INFO",
    "format": "json",
    "outputs": [
      "console",
      "file"
    ],
    "file": {
      "path": "/var/log/app.log",
      "max_size": "100MB",
      "rotation": "daily"
    }
  },
  "features": {
    "enable_cache": true,
    "cache_ttl": 3600,
    "rate_limit": 1000
  }
}