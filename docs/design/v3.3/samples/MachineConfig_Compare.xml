<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
  <Motion>
    <FeedSpeed>125</FeedSpeed>
    <Acceleration>500</Acceleration>
    <Deceleration>600</Deceleration>
    <PositionTolerance>0.05</PositionTolerance>
    <HomeOffset>0.2</HomeOffset>
  </Motion>
  <Thermal>
    <Setpoint>43</Setpoint>
    <AlarmLimit>60</AlarmLimit>
    <StabilizeDelay>30</StabilizeDelay>
