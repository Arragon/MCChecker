  <Pneumatic>
    <SupplyPressure>100</SupplyPressure>
    <VacuumThreshold>-60</VacuumThreshold>
  </Pneumatic>
  <Control>
    <PID>
      <P>2.4</P>
      <I>0.8</I>
      <D>0.1</D>
    </PID>
  </Control>
  <Safety>
    <DoorInterlock>true</DoorInterlock>
  </Safety>
  <Communication>
    <Timeout>6000</Timeout>
    <Retries>3</Retries>
  </Communication>
  <General>
    <StationName>装配工位 A</StationName>
  </General>
